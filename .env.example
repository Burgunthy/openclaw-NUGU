# NUGU + OpenClaw + Home Assistant 환경 설정 예시
# 이 파일을 복사하여 .env로 변경 후 실제 값을 입력하세요.

# ===========================================
# 웹훅 서버 설정
# ===========================================
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5000
WEBHOOK_DEBUG=false

# ===========================================
# OpenClaw 설정
# ===========================================
OPENCLAW_URL=http://127.0.0.1:8080
OPENCLAW_TOKEN=your_openclaw_token_here
OPENCLAW_TIMEOUT=300

# ===========================================
# Home Assistant 설정
# ===========================================
HA_URL=http://127.0.0.1:8123
HA_TOKEN=your_long_lived_access_token_here
HA_WEBHOOK_ID=nugu_to_openclaw

# ===========================================
# MQTT 설정 (SmartThings 연동용)
# ===========================================
MQTT_BROKER=core-mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_NUGU_COMMAND=nugu/command
MQTT_TOPIC_NUGU_RESPONSE=nugu/response

# ===========================================
# 로깅 설정
# ===========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===========================================
# 서버 정보 (배포용)
# ===========================================
SERVER_USER=jth
SERVER_HOST=192.168.0.25
SERVER_SSH_PORT=22
