# Caddy Reverse Proxy Configuration
# 외부 접속이 필요한 경우 사용

# HTTP를 HTTPS로 리디렉션
:80 {
    reverse_proxy nugu-webhook:5000
}

# HTTPS (Let's Encrypt 자동 인증서)
# 도메인이 있는 경우 주석 해제
#:443 {
#    reverse_proxy nugu-webhook:5000
#    tls your-email@example.com
#}

# 또는 자체 서명 인증서 (테스트용)
# :443 {
#     reverse_proxy nugu-webhook:5000
#     tls internal
# }
